---
import Site from '../../layouts/Site.astro';
import { ilimBagi, veriYukle, yol } from '../../lib/veri';

const v = await veriYukle();
// Hoca bölgesi × talebe bölgesi: ilim hangi bölgeden hangisine aktı?
const sayac = new Map<string, number>();
for (const k of v.kenarlar.filter(ilimBagi)) {
  const a = v.ravi.get(k.hoca)!.data.bolge;
  const b = v.ravi.get(k.talebe)!.data.bolge;
  sayac.set(`${a}>${b}`, (sayac.get(`${a}>${b}`) ?? 0) + 1);
}
const enCok = Math.max(...sayac.values());
const kisiler = (id: string) => v.raviler.filter((r) => r.data.bolge === id);
const anaBolgeler = v.bolgeler.filter((b) => !b.data.ek || kisiler(b.id).length > 0);
const tablodakiler = v.bolgeler.filter((b) => kisiler(b.id).length > 0);
---

<Site baslik="Bölgeler" genis>
  <h1>Bölgeler</h1>
  <p class="giris-not">Râvîler, ilmin geliştiği {anaBolgeler.length} bölgeye göre gruplandı. Bir bölgeyi açınca orada yetişenleri ve bölge dışına uzanan hoca-talebe bağlarını görürsünüz.</p>

  <ul class="bolgeler">
    {
      anaBolgeler.map((b) => (
        <li style={`--renk:${b.data.renk};--renk-koyu:${b.data.renk_koyu}`}>
          <a href={yol(`bolgeler/${b.id}/`)}>
            <span class="ad"><span class="nokta" />{b.data.isim}</span>
            <span class="sayi">{kisiler(b.id).length} râvî</span>
            <span class="aciklama">{b.data.aciklama}</span>
          </a>
        </li>
      ))
    }
  </ul>

  <h2>İlim hangi bölgeden hangisine aktı?</h2>
  <p class="giris-not">Satırda hocanın, sütunda talebenin bölgesi var. Hücredeki sayı, o iki bölge arasındaki hoca-talebe bağlantısıdır; renk koyulaştıkça bağlantı artar. Kişinin ana bölgesi esas alındı.</p>
  <div class="tablo-kap">
    <table>
      <thead>
        <tr>
          <th scope="col"><span class="gizli-metin">Hocanın bölgesi</span></th>
          {tablodakiler.map((b) => <th scope="col"><span class="dik">{b.data.isim}</span></th>)}
        </tr>
      </thead>
      <tbody>
        {
          tablodakiler.map((a) => (
            <tr>
              <th scope="row">{a.data.isim}</th>
              {tablodakiler.map((b) => {
                const n = sayac.get(`${a.id}>${b.id}`) ?? 0;
                return (
                  <td style={n ? `--yogunluk:${(0.12 + 0.88 * (n / enCok)).toFixed(2)}` : undefined} class:list={{ dolu: n > 0, kosegen: a.id === b.id, koyu: n / enCok > 0.45 }} title={n ? `${a.data.isim} → ${b.data.isim}: ${n}` : undefined}>
                    {n || ''}
                  </td>
                );
              })}
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
</Site>

<style>
  .giris-not { color: var(--murekkep-2); max-width: 68ch; }
  .bolgeler { list-style: none; margin: 1.5rem 0 3rem; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 2.5rem; border-top: 1px solid var(--cizgi); }
  .bolgeler a { display: grid; grid-template-columns: 1fr auto; gap: 2px 12px; padding: 14px 4px; border-bottom: 1px solid var(--cizgi); color: var(--murekkep); text-decoration: none; }
  .bolgeler a:hover .ad { color: var(--vurgu); }
  .ad { display: inline-flex; align-items: center; gap: 10px; font-weight: 600; }
  .sayi { font-size: 0.85rem; color: var(--murekkep-2); font-variant-numeric: tabular-nums; }
  .aciklama { grid-column: 1 / -1; font-size: 0.9rem; color: var(--murekkep-2); line-height: 1.5; padding-left: 20px; }
  .tablo-kap { overflow-x: auto; margin-top: 1rem; }
  table { border-collapse: collapse; font-size: 0.82rem; font-variant-numeric: tabular-nums; }
  th, td { padding: 0; text-align: center; }
  thead th { vertical-align: bottom; padding: 0 0 8px; font-weight: 500; color: var(--murekkep-2); }
  .dik { writing-mode: vertical-rl; transform: rotate(180deg); white-space: nowrap; display: inline-block; }
  tbody th { text-align: right; padding-right: 12px; font-weight: 500; white-space: nowrap; }
  td { width: 38px; height: 34px; min-width: 34px; border: 2px solid var(--kagit); background: var(--kagit-2); border-radius: 4px; }
  td.dolu { background: color-mix(in srgb, var(--vurgu) calc(var(--yogunluk) * 100%), var(--kart)); }
  td.koyu { color: #fff; font-weight: 600; }
  td.kosegen { outline: 1px solid var(--murekkep-2); outline-offset: -2px; }
  @media (max-width: 760px) { .bolgeler { grid-template-columns: 1fr; } }
</style>
