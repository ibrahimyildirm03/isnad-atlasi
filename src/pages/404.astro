---
import Site from '../layouts/Site.astro';
import { yol } from '../lib/veri';
---

<Site baslik="Sayfa bulunamadı" aciklama="Aradığınız sayfa bulunamadı.">
  <section class="bulunamadi">
    <h1>Bu adreste bir sayfa yok</h1>
    <p class="soluk">Sayfa taşınmış ya da adres yanlış yazılmış olabilir. Bir isim arayarak ya da aşağıdan devam edebilirsiniz.</p>
    <div class="eylem">
      <button type="button" class="dugme ana" data-ara-ac>İsim ara</button>
      <a class="dugme" href={yol()}>Ana sayfa</a>
      <a class="dugme" href={yol('raviler/')}>Râvîler</a>
    </div>
  </section>
</Site>

<style>
  .bulunamadi { max-width: 560px; padding: 3rem 0; }
  .eylem { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 1.5rem; }
</style>
