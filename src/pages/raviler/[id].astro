---
import Site from '../../layouts/Site.astro';
import Ag from '../../components/Ag.astro';
import BaglantiSatiri from '../../components/BaglantiSatiri.astro';
import {
  TABAKALAR,
  adVefat,
  grafVerisi,
  imamBaglantilari,
  ilimBagi,
  imamEtiketi,
  kaynakAdi,
  kaynakUrl,
  tarihYaz,
  veriYukle,
  yol,
  type Kenar,
  type Ravi,
} from '../../lib/veri';

export async function getStaticPaths() {
  const v = await veriYukle();
  return v.raviler.map((r) => ({ params: { id: r.id }, props: { id: r.id } }));
}

const v = await veriYukle();
const ravi: Ravi = v.ravi.get(Astro.props.id)!;
const d = ravi.data;
const bolgeler = [d.bolge, ...d.diger_bolgeler].map((b) => v.bolge.get(b)!);

const tumHocalar: Kenar[] = v.kenarlar.filter((k) => k.talebe === ravi.id);
const tumTalebeler: Kenar[] = v.talebeleri.get(ravi.id) ?? [];
const hocalar = tumHocalar.filter(ilimBagi);
const talebeler = tumTalebeler.filter(ilimBagi);
// Akrabalık bağlantıları (ilim aktarımı tespit edilemeyenler) ayrı listelenir
const akrabalar = [
  ...tumHocalar.filter((k) => !ilimBagi(k)).map((k) => ({ k, kisi: k.hoca })),
  ...tumTalebeler.filter((k) => !ilimBagi(k)).map((k) => ({ k, kisi: k.talebe })),
];
const komsular = new Set([ravi.id, ...tumHocalar.map((k) => k.hoca), ...tumTalebeler.map((k) => k.talebe)]);
const agVerisi = grafVerisi(v, komsular);
// Küçük ağda yalnızca kişinin kendi bağları çizilir; hocaların ve talebelerin birbirine bağları gösterilmez
agVerisi.kenarlar = agVerisi.kenarlar.filter((k) => k.hoca === ravi.id || k.talebe === ravi.id);

const baglantilar = imamBaglantilari(v, ravi.id).filter((b) => b.tur !== 'kendisi');
const dogrudan = baglantilar
  .filter((b) => b.tur === 'senedinde' || b.tur === 'talebe-zinciri')
  .sort((a, b) => a.yol.length - b.yol.length);
const dolayli = baglantilar.filter((b) => b.tur === 'dolayli');
const yok = baglantilar.filter((b) => b.tur === 'yok');

const isim = (id: string) => adVefat(v.ravi.get(id)!);
const kenarBul = (a: string, b: string) =>
  v.kenarlar.find((k) => (k.hoca === a && k.talebe === b) || (k.hoca === b && k.talebe === a));
const TUR_ADI = {
  senedinde: 'İlmi bu imama ulaşıyor',
  'talebe-zinciri': 'Bu imamdan ilim almış',
  dolayli: 'Ortak halkalar üzerinden',
} as const;

const sira = v.liste.findIndex((r) => r.id === ravi.id);
const onceki = sira > 0 ? v.liste[sira - 1] : undefined;
const sonraki = sira < v.liste.length - 1 ? v.liste[sira + 1] : undefined;
const bolumler = [
  ['hayati', 'Hayatı'],
  ...(d.eserleri.length ? [['eserleri', 'Eserleri']] : []),
  ['baglantilar', 'Hoca ve talebeleri'],
  ['imamlar', 'İmamlarla bağı'],
  ...(d.rical || d.cerh_tadil ? [['rical', 'Rical kitaplarında']] : []),
  ['kaynaklar', 'Kaynaklar'],
];
const ib = d.isim_bilgisi;
---
<Site baslik={d.isim} aciklama={d.ozet} genis>
  <nav class="iz" aria-label="Konum"><a href={yol('raviler/')}>Râvîler</a> / <a href={yol(`raviler/?tabaka=${d.tabaka}`)}>{TABAKALAR[d.tabaka]}</a></nav>

  <header class="bas">
    <h1>{d.isim} {d.vefat?.hicri != null && <span class="h1-tarih">(ö. {tarihYaz(d.vefat)})</span>}</h1>
    {d.tam_isim && <p class="tam-isim">{d.tam_isim}</p>}
    {d.arapca && <p class="arapca" lang="ar" dir="rtl">{d.arapca}</p>}
    <div class="etiketler">
      {bolgeler.map((b) => (
        <a href={yol(`bolgeler/${b.id}/`)} class="etiket" style={`--renk:${b.data.renk};--renk-koyu:${b.data.renk_koyu}`}><span class="nokta" />{b.data.isim}</a>
      ))}
      {d.imam && <span class:list={['etiket imam', { kesik: !d.imam.yasayan }]}>{imamEtiketi(ravi)}</span>}
      {d.kutub_i_tisa && <span class="etiket imam" title="Kütüb-i Tis'a">{d.kutub_i_tisa}</span>}
      {d.dogrulandi === true ? (
        <span class="etiket dogru" title="Bu kaydın bilgileri kaynaklardan kontrol edildi">Doğrulandı</span>
      ) : d.dogrulandi === 'kismi' ? (
        <span class="etiket kismi" title={d.dogrulama_notu ?? 'Bağlantıların bir kısmı kaynaklarla doğrulandı; kimlik ve tarih bilgileri henüz ayrıntılı kontrol edilmedi'}>Kısmen doğrulandı</span>
      ) : (
        <span class="etiket uyari" title="Bu kaydın bilgileri henüz kaynaklardan kontrol edilmedi">Doğrulanmadı</span>
      )}
    </div>
  </header>

  <div class="duzen">
    <aside class="yan">
      <dl class="kunye">
        {d.dogum && (<><dt>Doğum</dt><dd>{tarihYaz(d.dogum)}{d.dogum_yeri && <span class="alt">{d.dogum_yeri}</span>}</dd></>)}
        <dt>Vefat</dt>
        <dd>{tarihYaz(d.vefat)}{d.vefat?.not && <span class="alt">{d.vefat.not}</span>}{d.vefat_yeri && <span class="alt">{d.vefat_yeri}</span>}</dd>
        {!d.dogum && d.dogum_yeri && (<><dt>Doğum yeri</dt><dd>{d.dogum_yeri}</dd></>)}
        <dt>Kuşak</dt><dd>{TABAKALAR[d.tabaka]}</dd>
        {d.hadis_sayisi && (<><dt>Rivayeti</dt><dd title={d.hadis_sayisi.kaynak}>{d.hadis_sayisi.sayi.toLocaleString('tr-TR')} hadis</dd></>)}
        {ib?.ism && (<><dt>İsim</dt><dd>{ib.ism}</dd></>)}
        {ib?.kunye && (<><dt>Künye</dt><dd>{ib.kunye}</dd></>)}
        {ib?.lakap && (<><dt>Lakap</dt><dd>{ib.lakap}</dd></>)}
        {ib?.nesep && (<><dt>Nesep</dt><dd>{ib.nesep}</dd></>)}
        {ib?.nesep_arapca && (<><dt><span class="gizli-metin">Nesep, Arapça</span></dt><dd class="arapca" lang="ar" dir="rtl">{ib.nesep_arapca}</dd></>)}
        {ib && ib.nisbeler.length > 0 && (<><dt>Nisbeleri</dt><dd>{ib.nisbeler.join(', ')}</dd></>)}
      </dl>
      <p class="tarih-not">Tarihler hicrî / mîlâdî.</p>
      <nav class="bolum-nav" aria-label="Bu sayfada">
        {bolumler.map(([id, ad]) => <a href={`#${id}`}>{ad}</a>)}
      </nav>
    </aside>

    <article class="metin">
      <section id="hayati">
        <h2 class="gizli-metin">Hayatı</h2>
        {ib?.aciklama && <p class="isim-aciklama">{ib.aciklama}</p>}
        {d.biyografi ? d.biyografi.trim().split(/\n\s*\n/).map((p) => <p class="biyo">{p}</p>) : <p class="biyo">{d.ozet}</p>}
      </section>

      {d.eserleri.length > 0 && (
        <section id="eserleri">
          <h2>Eserleri</h2>
          <ul class="duz-liste">{d.eserleri.map((e) => <li><i>{e}</i></li>)}</ul>
        </section>
      )}

      <section id="baglantilar">
        <h2>Hoca ve talebeleri</h2>
        <Ag veri={agVerisi} mod="mini" merkez={ravi.id} sade />
        <p class="ipucu">Üstte hocaları, altta talebeleri. Kesikli çizgi aradaki bir râvî üzerinden, kırmızı kesikli çizgi ihtilaflı bağlantıdır. <a href={yol(`ag/?kisi=${ravi.id}`)}>Bağlantı ağında aç</a></p>
        <div class="iki-sutun">
          <section>
            <h3>Hocaları <span class="adet">{hocalar.length}</span></h3>
            {hocalar.length === 0 && <p class="soluk">Atlasta kayıtlı hocası yok.</p>}
            <ul class="bag-liste">{hocalar.map((k) => <BaglantiSatiri kenar={k} kisi={k.hoca} isim={isim(k.hoca)} />)}</ul>
          </section>
          <section>
            <h3>Talebeleri <span class="adet">{talebeler.length}</span></h3>
            {talebeler.length === 0 && <p class="soluk">Atlasta kayıtlı talebesi yok.</p>}
            <ul class="bag-liste">{talebeler.map((k) => <BaglantiSatiri kenar={k} kisi={k.talebe} isim={isim(k.talebe)} />)}</ul>
          </section>
          {akrabalar.length > 0 && (
            <section>
              <h3>Akrabaları <span class="adet">{akrabalar.length}</span></h3>
              <ul class="bag-liste">{akrabalar.map(({ k, kisi }) => <BaglantiSatiri kenar={k} kisi={kisi} isim={isim(kisi)} />)}</ul>
            </section>
          )}
        </div>
      </section>

      <section id="imamlar">
        <h2>Mezheb imamlarıyla bağı</h2>
        {dogrudan.length === 0 && <p class="soluk">Atlastaki veride bu kişiden bir imama uzanan hoca-talebe zinciri yok.</p>}
        <div class="zincirler">
          {dogrudan.map((b) => (
            <div class="zincir">
              <div class="zincir-bas">
                <a href={yol(`raviler/${b.imam.id}/`)}><b>{adVefat(b.imam)}</b></a>
                <span class="soluk">{TUR_ADI[b.tur as keyof typeof TUR_ADI]}, {b.yol.length - 1} adım</span>
              </div>
              <ol class="halkalar">
                {b.yol.map((id, i) => {
                  const k = i > 0 ? kenarBul(b.yol[i - 1], id) : undefined;
                  return (
                    <>
                      {k?.araci && <li class="ara">{k.araci}</li>}
                      <li class:list={[{ ben: id === ravi.id, imam: id === b.imam.id }]}>
                        {id === ravi.id ? isim(id) : <a href={yol(`raviler/${id}/`)}>{isim(id)}</a>}
                      </li>
                    </>
                  );
                })}
              </ol>
            </div>
          ))}
        </div>
        {dolayli.length > 0 && (
          <details>
            <summary>Ortak halkalar üzerinden bağlananlar ({dolayli.length} imam)</summary>
            <ul>{dolayli.map((b) => <li><b>{adVefat(b.imam)}</b>: {b.yol.map(isim).join(' — ')}</li>)}</ul>
          </details>
        )}
        {yok.length > 0 && <p class="kucuk">Bağlantı bulunamayan imamlar: {yok.map((b) => b.imam.data.isim).join(', ')}</p>}
      </section>

      {d.rical && (
        <section id="rical">
          <h2>Rical kitaplarında</h2>
          <dl class="rical-tablo">
            {d.rical.tehzibul_kemal && (<><dt>Mizzî, <i>Tehzîbü'l-Kemâl</i></dt><dd>{d.rical.tehzibul_kemal}</dd></>)}
            {d.rical.tehzibut_tehzib && (<><dt>İbn Hacer, <i>Tehzîbü't-Tehzîb</i></dt><dd>{d.rical.tehzibut_tehzib}</dd></>)}
            {d.rical.takrib && (<><dt>İbn Hacer, <i>Takrîb</i></dt><dd>{d.rical.takrib}</dd></>)}
            {d.rical.rumuz && (<><dt>Kütüb-i Sitte rumuzu</dt><dd><span lang="ar">{d.rical.rumuz}</span></dd></>)}
            {d.cerh_tadil && !d.rical.takrib && (<><dt>Cerh ve ta'dîl</dt><dd>{d.cerh_tadil}</dd></>)}
          </dl>
          {d.rical.sozler.length > 0 && (
            <ul class="sozler">{d.rical.sozler.map((z) => <li><b>{z.kim}:</b> “{z.soz}” {z.kaynak && <span class="soluk">({z.kaynak})</span>}</li>)}</ul>
          )}
          <p class="kucuk">Cilt ve sayfa numaraları TDV İslâm Ansiklopedisi maddelerinin bibliyografyasından ve Şâmile ravi kayıtlarından alındı; baskıya göre farklılık gösterebilir.</p>
        </section>
      )}
      {!d.rical && d.cerh_tadil && (<section id="rical"><h2>Cerh ve ta'dîl</h2><p>{d.cerh_tadil}</p></section>)}

      <section id="kaynaklar">
        <h2>Kaynaklar</h2>
        {d.kaynaklar.length ? (
          <ul class="duz-liste">{d.kaynaklar.map((k) => <li>{kaynakUrl(k) ? <a href={kaynakUrl(k)} target="_blank" rel="noopener">{kaynakAdi(k)}<span class="gizli-metin"> (yeni sekmede açılır)</span></a> : kaynakAdi(k)}</li>)}</ul>
        ) : <p class="soluk">Henüz kaynak eklenmedi.</p>}
      </section>
    </article>
  </div>

  <nav class="komsu" aria-label="Önceki ve sonraki râvî">
    {onceki ? <a class="onceki" href={yol(`raviler/${onceki.id}/`)}><span class="yon">Önceki</span>{adVefat(onceki)}</a> : <span />}
    {sonraki && <a class="sonraki" href={yol(`raviler/${sonraki.id}/`)}><span class="yon">Sonraki</span>{adVefat(sonraki)}</a>}
  </nav>
</Site>

<style>
  .iz { font-size: 0.85rem; color: var(--murekkep-2); }
  .iz a { color: var(--murekkep-2); }
  .bas { margin: 0.75rem 0 2rem; padding-bottom: 1.5rem; border-bottom: 1px solid var(--cizgi); }
  h1 { margin: 0; }
  .h1-tarih { font-size: 0.5em; font-weight: 400; color: var(--murekkep-2); white-space: nowrap; vertical-align: middle; }
  .tam-isim { font-size: 1.05rem; color: var(--murekkep-2); margin: 0.35rem 0 0; }
  .arapca { font-family: var(--arapca); font-size: 1.4rem; margin: 0.4rem 0 0; }
  .etiketler { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 1rem; }
  .etiketler a.etiket { text-decoration: none; }
  .kesik { border-style: dashed; }
  .dogru { color: var(--vurgu); border-color: var(--vurgu); background: var(--vurgu-acik); }
  .kismi { color: var(--vurgu); border-color: var(--vurgu); border-style: dashed; }

  .duzen > * { min-width: 0; }
  .duzen { display: grid; grid-template-columns: 250px minmax(0, 1fr); gap: 3.5rem; align-items: start; }
  .yan { position: sticky; top: calc(var(--ust-yukseklik) + 20px); font-size: 0.9rem; }
  .kunye { display: grid; grid-template-columns: 1fr; margin: 0; }
  .kunye dt { color: var(--murekkep-2); font-size: 0.8rem; margin-top: 0.75rem; }
  .kunye dt:first-child { margin-top: 0; }
  .kunye dd { margin: 0.1rem 0 0; font-weight: 500; }
  .kunye dd.arapca { font-size: 1.1rem; font-weight: 400; margin-top: 0.75rem; }
  .alt { display: block; font-weight: 400; color: var(--murekkep-2); }
  .tarih-not { font-size: 0.78rem; color: var(--murekkep-2); margin: 1rem 0 0; }
  .bolum-nav { display: flex; flex-direction: column; margin-top: 1.5rem; padding-top: 1rem; border-top: 1px solid var(--cizgi); }
  .bolum-nav a { padding: 5px 0 5px 12px; border-left: 2px solid var(--cizgi); color: var(--murekkep-2); text-decoration: none; }
  .bolum-nav a:hover { color: var(--vurgu); border-left-color: var(--vurgu); }

  .metin { max-width: 70ch; }
  .metin > section { scroll-margin-top: calc(var(--ust-yukseklik) + 16px); }
  .metin > section + section { margin-top: 2.75rem; }
  .metin h2 { margin-top: 0; }
  .biyo, .isim-aciklama { font-family: var(--serif); font-size: 1.1rem; line-height: 1.75; margin: 0 0 1.1rem; }
  .isim-aciklama { color: var(--murekkep-2); font-size: 1rem; }
  .ipucu { font-size: 0.82rem; color: var(--murekkep-2); margin-top: 8px; }
  .iki-sutun { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 0 2rem; margin-top: 1.5rem; }
  h3 { display: flex; align-items: baseline; gap: 8px; font-size: 1rem; margin: 0 0 0.4rem; }
  .adet { font-size: 0.82rem; font-weight: 500; color: var(--murekkep-2); }
  .bag-liste { list-style: none; padding: 0; margin: 0 0 1.25rem; }
  .zincirler { display: grid; gap: 0; }
  .zincir { padding: 14px 0; border-top: 1px solid var(--cizgi); }
  .zincir:last-child { border-bottom: 1px solid var(--cizgi); }
  .zincir-bas { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 4px 12px; font-size: 0.92rem; }
  .zincir-bas a { text-decoration: none; }
  .halkalar { list-style: none; padding: 0; margin: 0.6rem 0 0; display: flex; flex-wrap: wrap; align-items: center; gap: 4px 0; font-size: 0.86rem; }
  .halkalar li { padding: 2px 9px; border-radius: 6px; }
  .halkalar li:not(:first-child)::before { content: ''; display: inline-block; width: 14px; height: 1px; background: var(--murekkep-2); vertical-align: middle; margin: 0 8px 0 -9px; }
  .halkalar li a { text-decoration: none; }
  .halkalar .ben { background: var(--vurgu-acik); color: var(--vurgu); font-weight: 600; }
  .halkalar .imam { background: var(--altin-acik); }
  .halkalar .imam a { color: var(--altin); font-weight: 600; }
  .halkalar .ara { color: var(--murekkep-2); font-style: italic; border: 1px dashed var(--cizgi); }
  details { margin-top: 1rem; font-size: 0.9rem; }
  summary { cursor: pointer; color: var(--vurgu); }
  .kucuk { font-size: 0.82rem; color: var(--murekkep-2); margin-top: 1rem; }
  .duz-liste { padding-left: 1.1rem; }
  .duz-liste li { margin: 0.3rem 0; }
  .rical-tablo { display: grid; grid-template-columns: max-content 1fr; gap: 0.5rem 1.25rem; margin: 0; font-size: 0.92rem; }
  .rical-tablo dt { color: var(--murekkep-2); }
  .rical-tablo dd { margin: 0; }
  .sozler { padding-left: 1.1rem; }

  .komsu { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-top: 4rem; padding-top: 1.25rem; border-top: 1px solid var(--cizgi); }
  .komsu a { display: flex; flex-direction: column; gap: 2px; text-decoration: none; color: var(--murekkep); font-weight: 600; }
  .komsu a:hover { color: var(--vurgu); }
  .sonraki { text-align: right; grid-column: 2; }
  .yon { font-size: 0.8rem; font-weight: 400; color: var(--murekkep-2); }

  @media (max-width: 900px) {
    .duzen { grid-template-columns: minmax(0, 1fr); gap: 1.5rem; }
    .yan { position: static; }
    .kunye { grid-template-columns: 6.5rem minmax(0, 1fr); gap: 0.55rem 1rem; }
    .kunye dt, .kunye dt:first-child { margin-top: 0; }
    .kunye dd { margin: 0; }
    .kunye dd.arapca { grid-column: 1 / -1; margin: 0; text-align: right; }
    .bolum-nav { position: sticky; top: var(--ust-yukseklik); z-index: 4; flex-direction: row; gap: 6px; overflow-x: auto; scrollbar-width: none; background: var(--kagit); margin: 1.25rem -14px 0; padding: 10px 14px; border-top: 0; border-bottom: 1px solid var(--cizgi); }
    .bolum-nav a { border: 1px solid var(--cizgi); border-radius: 999px; padding: 4px 12px; white-space: nowrap; background: var(--kart); }
  }
  @media (max-width: 560px) { .rical-tablo { grid-template-columns: 1fr; } .rical-tablo dt { margin-top: 0.4rem; } }
</style>
