---
import '@fontsource-variable/ibm-plex-sans';
import '@fontsource/ibm-plex-serif/400.css';
import '@fontsource/ibm-plex-serif/400-italic.css';
import '@fontsource/ibm-plex-serif/600.css';
import '../styles/global.css';
import { TABAKALAR, veriYukle, yol } from '../lib/veri';

interface Props {
  baslik?: string;
  aciklama?: string;
  genis?: boolean;
}
const { baslik, aciklama = 'Sahâbeden mezheb imamlarına ve Kütüb-i Sitte müelliflerine, hicrî üç asırda ilmin aktarımı.', genis = false } = Astro.props;
const tamBaslik = baslik ? `${baslik} | İsnad Atlası` : 'İsnad Atlası';
const simdiki = Astro.url.pathname;
const kok = yol();
const menu = [
  { href: yol('raviler/'), ad: 'Râvîler', ikon: 'kisi' },
  { href: yol('bolgeler/'), ad: 'Bölgeler', ikon: 'bolge' },
  { href: yol('ag/'), ad: 'Bağlantı ağı', kisa: 'Ağ', ikon: 'ag' },
] as const;
const aktif = (href: string) => simdiki.startsWith(href);

// Hızlı arama için bütün kişiler (küçük bir liste; her sayfaya gömülür)
const v = await veriYukle();
const aramaListesi = v.liste.map((r) => ({
  id: r.id,
  i: r.data.isim,
  t: r.data.tam_isim ?? '',
  v: r.data.vefat?.hicri ?? null,
  b: v.bolge.get(r.data.bolge)?.data.isim ?? '',
  k: TABAKALAR[r.data.tabaka],
}));
---

<!doctype html>
<html lang="tr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{tamBaslik}</title>
    <meta name="description" content={aciklama} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="İsnad Atlası" />
    <meta property="og:locale" content="tr_TR" />
    <meta property="og:title" content={tamBaslik} />
    <meta property="og:description" content={aciklama} />
    {Astro.site && <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site).href} />}
    {Astro.site && <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site).href} />}
    {Astro.site && <meta property="og:image" content={new URL(yol('onizleme.png'), Astro.site).href} />}
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="İsnad Atlası" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={tamBaslik} />
    <meta name="twitter:description" content={aciklama} />
    <meta name="theme-color" content="#f4f5f7" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0e1219" media="(prefers-color-scheme: dark)" />
    <link rel="icon" type="image/svg+xml" href={yol('favicon.svg')} />
    <link rel="icon" type="image/png" sizes="32x32" href={yol('favicon.ico')} />
    <link rel="apple-touch-icon" href={yol('apple-touch-icon.png')} />
    <script is:inline>
      try {
        const t = localStorage.getItem('tema');
        if (t) document.documentElement.dataset.theme = t;
      } catch {}
    </script>
  </head>
  <body>
    <a class="atla" href="#icerik">İçeriğe geç</a>
    <header class="ust">
      <div class="kap ust-ic">
        <a href={kok} class="logo" aria-label="İsnad Atlası ana sayfa">
          <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
            <circle cx="12" cy="4" r="2.6" fill="currentColor" />
            <circle cx="12" cy="12" r="2.6" fill="currentColor" opacity="0.7" />
            <circle cx="12" cy="20" r="2.6" fill="var(--altin)" />
            <path d="M12 6.6v2.8M12 14.6v2.8" stroke="currentColor" stroke-width="1.6" />
          </svg>
          <span>İsnad Atlası</span>
        </a>

        <button class="ara-tetik" type="button" data-ara-ac aria-haspopup="dialog">
          <svg viewBox="0 0 24 24" width="17" height="17" aria-hidden="true"><circle cx="11" cy="11" r="6.5" fill="none" stroke="currentColor" stroke-width="2" /><path d="m16 16 4.5 4.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
          <span class="ara-metin">İsim ara</span>
          <kbd>/</kbd>
        </button>

        <nav class="ust-menu" aria-label="Ana menü">
          {menu.map((m) => (
            <a href={m.href} aria-current={aktif(m.href) ? 'page' : undefined}>{m.ad}</a>
          ))}
        </nav>

        <button class="tema" type="button" aria-label="Açık veya koyu temaya geç" title="Açık / koyu tema">
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M12 3a9 9 0 1 0 9 9 7 7 0 0 1-9-9Z" fill="currentColor" /></svg>
        </button>
      </div>
    </header>

    <main id="icerik" class:list={['kap', { dar: !genis }]}>
      <slot />
    </main>

    <footer class="kap alt">
      <p>Bilgiler TDV İslâm Ansiklopedisi ve el-Mektebetü'ş-Şâmile kaynaklı olarak, her kişinin sayfasında kaynaklarıyla verilmiştir.</p>
    </footer>

    <!-- Telefonda alt menü: başparmağın ulaştığı yerde -->
    <nav class="alt-menu" aria-label="Ana menü">
      <a href={kok} aria-current={simdiki === kok || simdiki === kok + '/' ? 'page' : undefined}>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 11 12 4l8 7v8a1 1 0 0 1-1 1h-4v-6H9v6H5a1 1 0 0 1-1-1z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" /></svg>
        <span>Ana sayfa</span>
      </a>
      {menu.map((m) => (
        <a href={m.href} aria-current={aktif(m.href) ? 'page' : undefined}>
          {m.ikon === 'kisi' && <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="3.5" fill="none" stroke="currentColor" stroke-width="1.8" /><path d="M5 20c.8-3.6 3.6-5.5 7-5.5s6.2 1.9 7 5.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /></svg>}
          {m.ikon === 'bolge' && <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s-6.5-5.6-6.5-11a6.5 6.5 0 0 1 13 0c0 5.4-6.5 11-6.5 11Z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" /><circle cx="12" cy="10" r="2.3" fill="currentColor" /></svg>}
          {m.ikon === 'ag' && <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="6" cy="6" r="2.4" fill="currentColor" /><circle cx="18" cy="6" r="2.4" fill="currentColor" /><circle cx="12" cy="18" r="2.4" fill="currentColor" /><path d="M7.5 8 11 16M16.5 8 13 16" stroke="currentColor" stroke-width="1.6" /></svg>}
          <span>{'kisa' in m ? m.kisa : m.ad}</span>
        </a>
      ))}
      <button type="button" data-ara-ac>
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.5" fill="none" stroke="currentColor" stroke-width="1.8" /><path d="m16 16 4.5 4.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /></svg>
        <span>Ara</span>
      </button>
    </nav>

    <dialog class="ara-pencere" aria-label="İsim ara">
      <form method="dialog" class="ara-kutu">
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><circle cx="11" cy="11" r="6.5" fill="none" stroke="currentColor" stroke-width="2" /><path d="m16 16 4.5 4.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
        <input type="search" data-ara-girdi placeholder="İsim, künye ya da nisbe yazın" autocomplete="off" aria-label="İsim ara" aria-controls="ara-sonuc" />
        <button class="kapat" value="kapat" aria-label="Aramayı kapat">Esc</button>
      </form>
      <ul id="ara-sonuc" class="ara-sonuc" role="listbox" data-ara-sonuc></ul>
      <p class="ara-bos" data-ara-bos hidden>Bu isimle kayıtlı kimse yok. Farklı bir yazımı deneyin; şapkalı harfleri yazmanıza gerek yok.</p>
    </dialog>
    <script type="application/json" id="ara-veri" set:html={JSON.stringify({ kok, liste: aramaListesi })} />

    <script>
      // Tema
      document.querySelector('.tema')?.addEventListener('click', () => {
        const kok = document.documentElement;
        const koyuMu = kok.dataset.theme ? kok.dataset.theme === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
        kok.dataset.theme = koyuMu ? 'light' : 'dark';
        try { localStorage.setItem('tema', kok.dataset.theme); } catch {}
        window.dispatchEvent(new Event('tema-degisti'));
      });

      // Hızlı isim arama
      type Kayit = { id: string; i: string; t: string; v: number | null; b: string; k: string };
      const { kok, liste } = JSON.parse(document.getElementById('ara-veri')!.textContent!) as { kok: string; liste: Kayit[] };
      const sadele = (s: string) =>
        s.toLocaleLowerCase('tr').normalize('NFD').replace(/[̀-ͯ]/g, '').replace(/ı/g, 'i').replace(/[‘’'`ʿʾ-]/g, '');
      const dizin = liste.map((k) => ({ k, ad: sadele(k.i), tam: sadele(`${k.i} ${k.t}`) }));
      const pencere = document.querySelector<HTMLDialogElement>('.ara-pencere')!;
      const girdi = pencere.querySelector<HTMLInputElement>('[data-ara-girdi]')!;
      const sonuc = pencere.querySelector<HTMLUListElement>('[data-ara-sonuc]')!;
      const bos = pencere.querySelector<HTMLElement>('[data-ara-bos]')!;
      let secili = 0;

      function ciz() {
        const q = sadele(girdi.value.trim());
        const bulunan = q
          ? dizin
              .filter((d) => d.tam.includes(q))
              .sort((a, b) => Number(!a.ad.startsWith(q)) - Number(!b.ad.startsWith(q)) || (a.k.v ?? 999) - (b.k.v ?? 999))
          : dizin;
        const ilk = bulunan.slice(0, 40);
        secili = 0;
        sonuc.replaceChildren(
          ...ilk.map(({ k }, i) => {
            const li = document.createElement('li');
            li.setAttribute('role', 'option');
            li.id = `ara-${k.id}`;
            if (i === 0) li.setAttribute('aria-selected', 'true');
            const a = document.createElement('a');
            a.href = `${kok.replace(/\/$/, '')}/raviler/${k.id}/`;
            const ad = document.createElement('span');
            ad.className = 'ad';
            ad.textContent = k.i;
            const ek = document.createElement('span');
            ek.className = 'ek';
            ek.textContent = [k.v != null ? `ö. ${k.v}` : null, k.b, k.k].filter(Boolean).join(', ');
            a.append(ad, ek);
            li.append(a);
            li.addEventListener('mousemove', () => isaretle(i));
            return li;
          }),
        );
        bos.hidden = ilk.length > 0;
      }
      function isaretle(i: number) {
        const ogeler = [...sonuc.children] as HTMLElement[];
        if (!ogeler.length) return;
        secili = (i + ogeler.length) % ogeler.length;
        ogeler.forEach((o, j) => o.toggleAttribute('aria-selected', j === secili));
        ogeler[secili].scrollIntoView({ block: 'nearest' });
        girdi.setAttribute('aria-activedescendant', ogeler[secili].id);
      }
      function ac() {
        girdi.value = '';
        ciz();
        pencere.showModal();
        girdi.focus();
      }
      girdi.addEventListener('input', ciz);
      girdi.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowDown') { e.preventDefault(); isaretle(secili + 1); }
        else if (e.key === 'ArrowUp') { e.preventDefault(); isaretle(secili - 1); }
        else if (e.key === 'Enter') {
          e.preventDefault();
          const a = sonuc.children[secili]?.querySelector('a');
          if (a) location.href = a.href;
        }
      });
      pencere.addEventListener('click', (e) => { if (e.target === pencere) pencere.close(); });
      document.querySelectorAll('[data-ara-ac]').forEach((b) => b.addEventListener('click', ac));
      document.addEventListener('keydown', (e) => {
        const hedef = e.target as HTMLElement;
        const yaziyor = hedef.closest('input, textarea, select, [contenteditable]');
        if (!yaziyor && !pencere.open && (e.key === '/' || ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k'))) {
          e.preventDefault();
          ac();
        }
      });
    </script>
  </body>
</html>

<style>
  .atla { position: absolute; left: -999px; top: 8px; z-index: 100; background: var(--kart); padding: 8px 12px; border-radius: 8px; }
  .atla:focus { left: 12px; }

  .ust {
    position: sticky; top: 0; z-index: 30;
    background: color-mix(in srgb, var(--kagit) 90%, transparent);
    backdrop-filter: saturate(1.4) blur(10px);
    border-bottom: 1px solid var(--cizgi);
  }
  .ust-ic { display: flex; align-items: center; gap: 14px; height: var(--ust-yukseklik); }
  .logo {
    display: flex; align-items: center; gap: 9px; color: var(--murekkep); text-decoration: none;
    font-weight: 600; font-size: 1.02rem; letter-spacing: -0.01em; white-space: nowrap;
  }
  .logo svg { color: var(--vurgu); }

  .ara-tetik {
    display: flex; align-items: center; gap: 8px; margin-left: 8px; flex: 0 1 280px; min-width: 0;
    background: var(--kart); border: 1px solid var(--cizgi); border-radius: 8px; padding: 7px 10px;
    color: var(--murekkep-2); cursor: pointer; text-align: left;
  }
  .ara-tetik:hover { border-color: var(--murekkep-2); }
  .ara-metin { flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  kbd {
    font-family: var(--sans); font-size: 0.75rem; color: var(--murekkep-2);
    border: 1px solid var(--cizgi); border-radius: 5px; padding: 0 6px; line-height: 1.5;
  }

  .ust-menu { display: flex; gap: 2px; margin-left: auto; }
  .ust-menu a {
    color: var(--murekkep-2); text-decoration: none; font-size: 0.93rem; font-weight: 500;
    padding: 7px 11px; border-radius: 8px;
  }
  .ust-menu a:hover { color: var(--murekkep); background: var(--kagit-2); }
  .ust-menu a[aria-current='page'] { color: var(--murekkep); background: var(--kagit-2); }
  .tema {
    background: none; border: 0; color: var(--murekkep-2); cursor: pointer; padding: 8px; border-radius: 8px; display: flex;
  }
  .tema:hover { background: var(--kagit-2); color: var(--murekkep); }

  main { padding-top: 2.25rem; padding-bottom: 4.5rem; min-height: 70vh; }
  .alt { border-top: 1px solid var(--cizgi); padding-top: 1.1rem; padding-bottom: 2rem; font-size: 0.85rem; color: var(--murekkep-2); }
  .alt p { margin: 0; max-width: 70ch; }

  .alt-menu { display: none; }

  @media (max-width: 760px) {
    .ust-menu, .ara-tetik { display: none; }
    .ust-ic { justify-content: space-between; }
    main { padding-top: 1.5rem; padding-bottom: 6.5rem; }
    .alt { padding-bottom: calc(5.5rem + env(safe-area-inset-bottom)); }
    .alt-menu {
      display: grid; grid-template-columns: repeat(5, 1fr);
      position: fixed; left: 0; right: 0; bottom: 0; z-index: 40;
      background: color-mix(in srgb, var(--kart) 94%, transparent); backdrop-filter: blur(12px);
      border-top: 1px solid var(--cizgi);
      padding: 6px 4px calc(6px + env(safe-area-inset-bottom));
    }
    .alt-menu a, .alt-menu button {
      display: flex; flex-direction: column; align-items: center; gap: 2px;
      color: var(--murekkep-2); text-decoration: none; background: none; border: 0; cursor: pointer;
      font-size: 0.7rem; font-weight: 500; padding: 4px 0; border-radius: 8px;
    }
    .alt-menu svg { width: 22px; height: 22px; }
    .alt-menu [aria-current='page'] { color: var(--vurgu); }
  }

  .ara-pencere {
    width: min(620px, calc(100vw - 24px)); max-height: min(560px, calc(100dvh - 80px));
    margin: 10vh auto auto; padding: 0; border: 1px solid var(--cizgi); border-radius: 14px;
    background: var(--kart); color: var(--murekkep); box-shadow: var(--golge-yuksek);
    overflow: hidden; flex-direction: column;
  }
  .ara-pencere[open] { display: flex; }
  .ara-pencere::backdrop { background: rgb(14 18 25 / 0.45); backdrop-filter: blur(2px); }
  .ara-kutu { display: flex; align-items: center; gap: 10px; padding: 12px 14px; border-bottom: 1px solid var(--cizgi); color: var(--murekkep-2); }
  .ara-kutu input { flex: 1; border: 0; padding: 6px 0; font-size: 1.05rem; background: transparent; }
  .ara-kutu input:focus { outline: none; }
  .kapat { border: 1px solid var(--cizgi); background: none; border-radius: 6px; font-size: 0.75rem; padding: 2px 7px; color: var(--murekkep-2); cursor: pointer; }
  .ara-sonuc { list-style: none; margin: 0; padding: 6px; overflow-y: auto; }
  .ara-sonuc :global(a) {
    display: flex; flex-direction: column; padding: 8px 10px; border-radius: 8px; text-decoration: none; color: var(--murekkep);
  }
  .ara-sonuc :global([aria-selected] a) { background: var(--vurgu-acik); }
  .ara-sonuc :global(.ad) { font-weight: 500; }
  .ara-sonuc :global(.ek) { font-size: 0.8rem; color: var(--murekkep-2); }
  .ara-bos { margin: 0; padding: 16px 18px; color: var(--murekkep-2); font-size: 0.92rem; }
  @media (max-width: 760px) {
    .ara-pencere { margin: 0; width: 100vw; max-width: 100vw; height: 100dvh; max-height: 100dvh; border-radius: 0; border: 0; }
  }
</style>
